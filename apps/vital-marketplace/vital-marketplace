#!/usr/bin/env python3
"""Vital Marketplace — browse and install catalog items."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk

for extra in (
    Path("/usr/lib/vitalos"),
    Path(__file__).resolve().parents[2] / "marketplace" / "python",
    Path(__file__).resolve().parent,
):
    if extra.is_dir() and str(extra) not in sys.path:
        sys.path.insert(0, str(extra))

from vital_catalog import (  # noqa: E402
    hashes_match,
    load_client_catalog,
    read_config,
    resolve_bundled,
)

APP_ID = "org.vitalos.Marketplace"
HELPERS = (
    Path("/usr/libexec/vital-marketplace-helper"),
    Path(__file__).resolve().parent / "vital-marketplace-helper",
)


def config_path() -> Path:
    override = os.environ.get("VITAL_MARKET_CONF", "")
    if override:
        return Path(override)
    system = Path("/etc/vital/marketplace.conf")
    if system.is_file():
        return system
    return Path(__file__).resolve().parents[2] / "overlay" / "etc" / "vital" / "marketplace.conf"


def dev_config() -> dict[str, str]:
    root = Path(__file__).resolve().parents[2]
    values = read_config(config_path())
    bundled = Path(values.get("bundled_catalog", ""))
    if not bundled.is_file():
        values["bundled_catalog"] = str(root / "marketplace" / "catalog" / "catalog.json")
    public = Path(values.get("public_key", ""))
    if not public.is_file():
        values["public_key"] = str(root / "marketplace" / "keys" / "catalog.pub")
    return values


def helper_path() -> Path:
    for path in HELPERS:
        if path.is_file():
            return path
    raise FileNotFoundError("vital-marketplace-helper")


def _run(command: list[str]) -> subprocess.CompletedProcess | None:
    try:
        return subprocess.run(command, check=False, capture_output=True, text=True)
    except FileNotFoundError:
        return None


def package_installed(item: dict) -> bool | None:
    method = item["install"]["method"]
    if method in {"apt", "deb"}:
        package = item["install"].get("package")
        if not package:
            stamp = Path("/var/lib/vitalos/marketplace/installed") / item["id"]
            return stamp.is_file()
        completed = _run(["dpkg-query", "-W", "-f", "${Status}", package])
        if completed is None:
            return None
        return "install ok installed" in completed.stdout
    if method == "flatpak":
        completed = _run(["flatpak", "info", item["install"]["flatpak_id"]])
        if completed is None:
            return None
        return completed.returncode == 0
    if method == "script":
        return (Path("/var/lib/vitalos/marketplace/installed") / item["id"]).is_file()
    return None


class MarketWindow(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application) -> None:
        super().__init__(application=app, title="Vital Marketplace")
        self.set_default_size(980, 680)
        try:
            self.catalog, self.source = load_client_catalog(dev_config())
        except (OSError, ValueError) as exc:
            self.catalog = {"items": []}
            self.source = f"error: {exc}"
        self.items = list(self.catalog.get("items", []))
        self.category = "All"
        self.query = ""
        self._busy = False

        self.nav = Adw.NavigationView()
        self.nav.add(self._browse_page())
        self.set_content(self.nav)

    def _browse_page(self) -> Adw.NavigationPage:
        sidebar = Gtk.ListBox()
        sidebar.add_css_class("navigation-sidebar")
        sidebar.set_selection_mode(Gtk.SelectionMode.SINGLE)
        categories = ["All"]
        for item in self.items:
            if item["category"] not in categories:
                categories.append(item["category"])
        for name in categories:
            row = Gtk.Label(label=name, xalign=0)
            row.set_margin_top(8)
            row.set_margin_bottom(8)
            row.set_margin_start(12)
            row.set_margin_end(12)
            sidebar.append(row)
        sidebar.select_row(sidebar.get_row_at_index(0))
        sidebar.connect("row-selected", self._on_category)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search")
        self.search.connect("search-changed", self._on_search)

        self.list = Gtk.ListBox()
        self.list.set_selection_mode(Gtk.SelectionMode.NONE)
        self.list.add_css_class("boxed-list")
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(self.list)
        scrolled.set_vexpand(True)
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        main.set_margin_top(16)
        main.set_margin_bottom(16)
        main.set_margin_start(16)
        main.set_margin_end(16)
        if self.source != "remote":
            banner = Adw.Banner()
            banner.set_title(
                "Showing the unsigned sample catalog shipped with this image. "
                "A signed catalog from vital-os.org is used when it can be reached."
            )
            banner.set_revealed(True)
            main.append(banner)
        main.append(self.search)
        main.append(scrolled)

        split = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        side_scroll = Gtk.ScrolledWindow()
        side_scroll.set_child(sidebar)
        side_scroll.set_size_request(180, -1)
        side_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        split.append(side_scroll)
        split.append(main)
        main.set_hexpand(True)

        header = Adw.HeaderBar()
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(split)
        self._fill_list()
        return Adw.NavigationPage.new(view, "Vital Marketplace")

    def _on_category(self, _box: Gtk.ListBox, row: Gtk.ListBoxRow | None) -> None:
        if row is None:
            return
        label = row.get_child()
        if isinstance(label, Gtk.Label):
            self.category = label.get_label()
            self._fill_list()

    def _on_search(self, entry: Gtk.SearchEntry) -> None:
        self.query = entry.get_text().strip().lower()
        self._fill_list()

    def _visible_items(self) -> list[dict]:
        found = []
        for item in self.items:
            if self.category != "All" and item["category"] != self.category:
                continue
            haystack = " ".join(
                [item["name"], item["summary"], item["description"], item["category"]]
            ).lower()
            if self.query and self.query not in haystack:
                continue
            found.append(item)
        return found

    def _fill_list(self) -> None:
        while True:
            child = self.list.get_row_at_index(0)
            if child is None:
                break
            self.list.remove(child)
        for item in self._visible_items():
            row = Adw.ActionRow(title=item["name"], subtitle=item["summary"])
            if item.get("example"):
                row.set_subtitle("Example. " + item["summary"])
            button = Gtk.Button(label="Details")
            button.set_valign(Gtk.Align.CENTER)
            button.connect("clicked", self._open_details, item)
            row.add_suffix(button)
            row.set_activatable_widget(button)
            self.list.append(row)

    def _open_details(self, _button: Gtk.Button, item: dict) -> None:
        self.nav.push(self._details_page(item))

    def _details_page(self, item: dict) -> Adw.NavigationPage:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.set_margin_top(18)
        box.set_margin_bottom(18)
        box.set_margin_start(24)
        box.set_margin_end(24)
        title = Gtk.Label(label=item["name"], xalign=0)
        title.add_css_class("title-1")
        box.append(title)
        if item.get("example"):
            note = Gtk.Label(
                label="Example entry. This is not a product listing. A script asks for confirmation and is checked with SHA-256.",
                xalign=0,
                wrap=True,
            )
            note.add_css_class("warning")
            box.append(note)
        summary = Gtk.Label(label=item["summary"], xalign=0, wrap=True)
        summary.add_css_class("dim-label")
        box.append(summary)
        body = Gtk.Label(label=item["description"], xalign=0, wrap=True)
        box.append(body)
        meta = Gtk.Label(
            label=(
                f"{item['version']}  ·  {item['category']}\n"
                f"{item['publisher']}  ·  {item['license']}\n"
                f"{item['homepage']}\n"
                f"Install method: {item['install']['method']}"
            ),
            xalign=0,
            wrap=True,
        )
        meta.add_css_class("dim-label")
        meta.set_margin_top(8)
        box.append(meta)

        self.progress = Gtk.ProgressBar()
        self.progress.set_show_text(True)
        self.progress.set_fraction(0)
        self.progress.set_visible(False)
        box.append(self.progress)
        self.status = Gtk.Label(label="", xalign=0, wrap=True)
        box.append(self.status)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        install = Gtk.Button(label="Install")
        install.add_css_class("suggested-action")
        install.connect("clicked", lambda _b: self._begin(item, "install"))
        update = Gtk.Button(label="Update")
        update.connect("clicked", lambda _b: self._begin(item, "upgrade"))
        remove = Gtk.Button(label="Uninstall")
        remove.add_css_class("destructive-action")
        remove.connect("clicked", lambda _b: self._begin(item, "remove"))
        state = package_installed(item)
        if state is True:
            install.set_sensitive(False)
        elif state is False and item["install"]["method"] != "script":
            remove.set_sensitive(False)
        actions.append(install)
        actions.append(update)
        actions.append(remove)
        box.append(actions)

        scroll = Gtk.ScrolledWindow()
        scroll.set_child(box)
        header = Adw.HeaderBar()
        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.set_content(scroll)
        return Adw.NavigationPage.new(view, item["name"])

    def reveal_preview(self) -> None:
        view = os.environ.get("VITAL_MARKET_VIEW", "")
        shot = os.environ.get("VITAL_MARKET_SHOT", "")
        if view == "detail" and self.items:
            chosen = next((item for item in self.items if item["id"] == "gimp"), self.items[0])
            self.nav.push(self._details_page(chosen))
        if shot:
            GLib.timeout_add(200, self._save_shot, shot, view)

    def _save_shot(self, path: str, view: str = "") -> bool:
        try:
            if view == "detail":
                visible = self.nav.get_visible_page()
                title = visible.get_title() if visible is not None else ""
                self._shot_tries = getattr(self, "_shot_tries", 0) + 1
                if title == "Vital Marketplace" and self._shot_tries < 25:
                    return True
            return self._write_png(path)
        except Exception as exc:
            Path("/tmp/vital-market-shot.txt").write_text(str(exc), encoding="utf-8")
            self.close()
            return False

    def _write_png(self, path: str) -> bool:
        width = self.get_width()
        height = self.get_height()
        if width < 100 or height < 100:
            return True
        gi.require_version("Gsk", "4.0")
        from gi.repository import Gsk

        paintable = Gtk.WidgetPaintable.new(self)
        snapshot = Gtk.Snapshot()
        paintable.snapshot(snapshot, width, height)
        node = snapshot.to_node()
        if node is None:
            return True
        native = self.get_native()
        renderer = native.get_renderer() if native is not None and hasattr(native, "get_renderer") else None
        if renderer is None:
            renderer = Gsk.CairoRenderer.new()
            surface = native.get_surface() if native is not None else None
            if not renderer.realize(surface):
                return True
        renderer.render_texture(node, None).save_to_png(path)
        self.close()
        return False

    def _begin(self, item: dict, action: str) -> None:
        if self._busy:
            return
        if item["install"]["method"] == "script" and action in {"install", "upgrade"}:
            self._confirm_script(item, action)
            return
        self._start(item, action, confirmed=False)

    def _confirm_script(self, item: dict, action: str) -> None:
        preview = self._script_preview(item)
        body = (
            f"{item['install']['url']}\n"
            f"SHA-256 {item['install']['sha256']}\n\n"
            f"{preview}\n\n"
            "The helper downloads this file again and refuses it if the checksum changes."
        )
        dialog = Adw.AlertDialog(heading="Run this script?", body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("run", "Run script")
        dialog.set_response_appearance("run", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def respond(_dialog: Adw.AlertDialog, response: str) -> None:
            if response == "run":
                self._start(item, action, confirmed=True)

        dialog.connect("response", respond)
        dialog.present(self)

    def _script_preview(self, item: dict) -> str:
        url = item["install"]["url"]
        root = Path(dev_config()["bundled_catalog"]).parent
        if not url.startswith("bundled://"):
            return "The script is remote. Its text is shown after the checksum matches on this machine."
        try:
            path = resolve_bundled(url, root)
        except ValueError as exc:
            return str(exc)
        if not hashes_match(path, item["install"]["sha256"]):
            return "The local example does not match its published checksum. It will not run."
        text = path.read_text(encoding="utf-8", errors="replace")
        lines = text.splitlines()[:40]
        return "\n".join(lines)

    def _start(self, item: dict, action: str, confirmed: bool) -> None:
        self._busy = True
        self.progress.set_visible(True)
        self.progress.set_fraction(0.05)
        self.status.set_label("Waiting for authorization…")
        thread = threading.Thread(
            target=self._run_helper,
            args=(item, action, confirmed),
            daemon=True,
        )
        thread.start()

    def _run_helper(self, item: dict, action: str, confirmed: bool) -> None:
        request = {
            "action": action,
            "id": item["id"],
            "confirmed": confirmed,
            "catalog": dev_config().get("bundled_catalog", ""),
        }
        try:
            handle = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8")
            json.dump(request, handle)
            handle.close()
            command = ["pkexec", str(helper_path()), handle.name]
            if os.environ.get("VITAL_MARKET_DRY_RUN") == "1":
                command = [str(helper_path()), handle.name]
                env = os.environ.copy()
                env["VITAL_MARKET_HELPER_DRY_RUN"] = "1"
            else:
                env = None
            completed = subprocess.run(command, check=False, capture_output=True, text=True, env=env)
            output = (completed.stdout or "") + (completed.stderr or "")
            GLib.idle_add(self._finish, completed.returncode, output)
        except OSError as exc:
            GLib.idle_add(self._finish, 1, str(exc))

    def _finish(self, code: int, output: str) -> bool:
        self._busy = False
        fraction = 1 if code == 0 else 0
        message = "Finished." if code == 0 else "The change did not complete."
        for line in output.splitlines():
            if line.startswith("STATUS "):
                parts = line.split(" ", 2)
                if len(parts) == 3 and parts[1].isdigit():
                    fraction = int(parts[1]) / 100
                    message = parts[2]
            elif line.startswith("ERROR "):
                message = line.removeprefix("ERROR ")
        self.progress.set_fraction(fraction)
        self.status.set_label(message)
        return False


class MarketApp(Adw.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_startup(self) -> None:
        Adw.Application.do_startup(self)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            @define-color accent_bg_color #c6a56a;
            @define-color accent_fg_color #14110c;
            @define-color accent_color #e6d3a4;
            """
        )
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def do_activate(self) -> None:
        window = self.props.active_window
        if window is None:
            window = MarketWindow(self)
        window.present()
        window.reveal_preview()


def main() -> int:
    return MarketApp().run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
