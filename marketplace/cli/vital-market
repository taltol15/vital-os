#!/usr/bin/env python3
"""Admin CLI for the Vital Marketplace catalog service.

    vital-market keygen --private /etc/vital/market.key --public /etc/vital/marketplace.pub
    vital-market token create --db /var/lib/vital-market/market.db --name tal
    vital-market publish --server https://vital-os.org --token "$TOKEN" manifest.json

The token is printed once. The database stores only its SHA-256.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sqlite3
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
sys.path.insert(0, "/usr/lib/vitalos")

from vital_catalog import validate_item  # noqa: E402


def _die(message: str) -> None:
    print(f"vital-market: {message}", file=sys.stderr)
    raise SystemExit(1)


def cmd_keygen(args: argparse.Namespace) -> None:
    import base64

    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
    from cryptography.hazmat.primitives.serialization import (
        Encoding,
        NoEncryption,
        PrivateFormat,
        PublicFormat,
    )

    private = Path(args.private)
    public = Path(args.public)
    if private.exists() and not args.force:
        _die(f"{private} already exists (pass --force to replace it)")
    key = Ed25519PrivateKey.generate()
    private.parent.mkdir(parents=True, exist_ok=True)
    private.write_bytes(key.private_bytes(Encoding.PEM, PrivateFormat.PKCS8, NoEncryption()))
    os.chmod(private, 0o600)
    raw = key.public_key().public_bytes(Encoding.Raw, PublicFormat.Raw)
    public.parent.mkdir(parents=True, exist_ok=True)
    public.write_text(base64.b64encode(raw).decode("ascii") + "\n", encoding="utf-8")
    os.chmod(public, 0o644)
    print(f"wrote {private} (mode 600) and {public}")


def _connect(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(path)
    db.execute(
        """
        CREATE TABLE IF NOT EXISTS tokens (
            id INTEGER PRIMARY KEY,
            name TEXT NOT NULL,
            token_hash TEXT NOT NULL UNIQUE,
            created_at TEXT NOT NULL
        )
        """
    )
    return db


def cmd_token(args: argparse.Namespace) -> None:
    import secrets

    token = "vmt_" + secrets.token_urlsafe(32)
    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
    created = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with _connect(Path(args.db)) as db:
        db.execute(
            "INSERT INTO tokens (name, token_hash, created_at) VALUES (?, ?, ?)",
            (args.name, digest, created),
        )
        db.commit()
    print(token)


def _request(url: str, token: str, payload: dict, method: str) -> None:
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "User-Agent": "vital-market/0.1",
        },
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        _die(f"{method} {url} failed ({exc.code}): {detail}")
    print(body)


def cmd_publish(args: argparse.Namespace) -> None:
    token = args.token or os.environ.get("VITAL_MARKET_TOKEN", "")
    if not token:
        _die("pass --token or set VITAL_MARKET_TOKEN")
    document = json.loads(Path(args.manifest).read_text(encoding="utf-8"))
    items = document["items"] if isinstance(document, dict) and "items" in document else [document]
    if not isinstance(items, list) or not items:
        _die("manifest has no items")
    base = args.server.rstrip("/")
    method = "PUT" if args.update else "POST"
    for item in items:
        errors = validate_item(item)
        if errors:
            _die(f"{item.get('id', '?')}: " + "; ".join(errors))
        if method == "PUT":
            url = f"{base}/api/v1/admin/items/{item['id']}"
        else:
            url = f"{base}/api/v1/admin/items"
        _request(url, token, item, method)


def main() -> int:
    parser = argparse.ArgumentParser(description="Vital Marketplace admin CLI")
    sub = parser.add_subparsers(dest="command", required=True)

    keygen = sub.add_parser("keygen", help="write an ed25519 keypair")
    keygen.add_argument("--private", required=True)
    keygen.add_argument("--public", required=True)
    keygen.add_argument("--force", action="store_true")
    keygen.set_defaults(func=cmd_keygen)

    token = sub.add_parser("token", help="manage API tokens")
    token_sub = token.add_subparsers(dest="token_command", required=True)
    create = token_sub.add_parser("create", help="print a new bearer token")
    create.add_argument("--db", required=True)
    create.add_argument("--name", required=True)
    create.set_defaults(func=cmd_token)

    publish = sub.add_parser("publish", help="create or update catalog items")
    publish.add_argument("--server", required=True)
    publish.add_argument("--token", default="")
    publish.add_argument("--update", action="store_true", help="PUT existing items")
    publish.add_argument("manifest")
    publish.set_defaults(func=cmd_publish)

    args = parser.parse_args()
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
