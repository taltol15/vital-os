{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/taltol15/vital-os/marketplace/schema/catalog.schema.json",
  "title": "Vital Marketplace catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "name", "issued", "items"],
  "properties": {
    "format": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "issued": { "type": "string", "minLength": 4 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "catalog-item.schema.json" }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": { "type": "string" },
        "value": { "type": "string", "minLength": 1 }
      },
      "description": "ed25519 signature of the canonical catalog JSON with this field removed."
    }
  }
}
