# Keep Ubuntu's snap-transitional Firefox and branded metapackages out of the image.
Package: firefox*
Pin: release o=Ubuntu
Pin-Priority: -1

Package: firefox*
Pin: origin packages.mozilla.org
Pin-Priority: 1000

Package: ubuntu-session
Pin: release *
Pin-Priority: -1

Package: ubuntu-desktop
Pin: release *
Pin-Priority: -1

Package: ubuntu-desktop-minimal
Pin: release *
Pin-Priority: -1

Package: ubuntu-wallpapers
Pin: release o=Ubuntu
Pin-Priority: -1

Package: yaru*
Pin: release *
Pin-Priority: -1

Package: snapd
Pin: release *
Pin-Priority: -1

Package: gnome-software-plugin-snap
Pin: release *
Pin-Priority: -1

Package: ubuntu-report
Pin: release *
Pin-Priority: -1

Package: apport
Pin: release *
Pin-Priority: -1

Package: apport-gtk
Pin: release *
Pin-Priority: -1

# Ubuntu's signed GRUB is built to find Ubuntu's layout and the live image
# (/.disk/info). grub-install copies that binary onto the EFI fallback path,
# so an installed disk drops to a GRUB prompt. Secure Boot is not supported.
Package: grub-efi-amd64-signed
Pin: release *
Pin-Priority: -1

Package: shim-signed
Pin: release *
Pin-Priority: -1
