# Vital OS boot theme. A champagne V draws itself, then a soft glow.
# Refresh work is a sprite swap, not a new image.

Window.SetBackgroundTopColor(0.047, 0.059, 0.078);
Window.SetBackgroundBottomColor(0.020, 0.024, 0.031);

frame1.image = Image("frame-01.png");
frame2.image = Image("frame-02.png");
frame3.image = Image("frame-03.png");
frame4.image = Image("frame-04.png");
frame5.image = Image("frame-05.png");
frame6.image = Image("frame-06.png");
frame7.image = Image("frame-07.png");
frame8.image = Image("frame-08.png");

logo.sprite = Sprite(frame1.image);
logo.sprite.SetOpacity(1);

glow.sprite = Sprite(frame8.image);
glow.sprite.SetOpacity(0);

progress_box.image = Image("progress.png");
progress_box.sprite = Sprite();
progress_box.sprite.SetOpacity(0);

tick = 0;
boot_progress = 0;
drawn = 0.02;
step = 0;

fun place_logo(sprite, image) {
    sprite.SetX(Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(Window.GetHeight() / 2 - image.GetHeight() / 2 - 24);
}

fun paint_bar(amount) {
    bar_w = Window.GetWidth() / 7;
    if (bar_w < 140) bar_w = 140;
    if (bar_w > 280) bar_w = 280;
    filled = bar_w * amount;
    if (filled < 2) filled = 2;
    progress_box.sprite.SetImage(progress_box.image.Scale(filled, 2));
    progress_box.sprite.SetX(Window.GetWidth() / 2 - bar_w / 2);
    progress_box.sprite.SetY(Window.GetHeight() / 2 + frame8.image.GetHeight() / 2 + 18);
}

fun show_step(index) {
    if (index < 2) logo.sprite.SetImage(frame1.image);
    else if (index < 3) logo.sprite.SetImage(frame2.image);
    else if (index < 4) logo.sprite.SetImage(frame3.image);
    else if (index < 5) logo.sprite.SetImage(frame4.image);
    else if (index < 6) logo.sprite.SetImage(frame5.image);
    else if (index < 7) logo.sprite.SetImage(frame6.image);
    else if (index < 8) logo.sprite.SetImage(frame7.image);
    else logo.sprite.SetImage(frame8.image);
}

place_logo(logo.sprite, frame1.image);
place_logo(glow.sprite, frame8.image);
paint_bar(0.04);

fun refresh_callback() {
    tick = tick + 1;
    if (tick < 56) {
        step = tick / 7;
    } else {
        step = 8;
    }
    show_step(step);
    place_logo(logo.sprite, frame8.image);

    if (step < 8) {
        glow.sprite.SetOpacity(0);
    } else {
        phase = tick - (tick / 48) * 48;
        if (phase > 24) phase = 48 - phase;
        glow.sprite.SetOpacity(phase / 24 * 0.22);
        place_logo(glow.sprite, frame8.image);
    }

    if (boot_progress < 0.04) {
        progress_box.sprite.SetOpacity(0.35);
        target = 0.08;
    } else {
        progress_box.sprite.SetOpacity(0.92);
        target = boot_progress;
    }
    drawn = drawn + (target - drawn) * 0.18;
    if (drawn < 0.02) drawn = 0.02;
    paint_bar(drawn);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun progress_callback(duration, progress) {
    boot_progress = progress;
}

Plymouth.SetBootProgressFunction(progress_callback);

message_sprite = Sprite();

fun message_callback(text) {
    message_image = Image.Text(text, 0.90, 0.82, 0.64, 1);
    message_sprite.SetImage(message_image);
    message_sprite.SetX(Window.GetWidth() / 2 - message_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetHeight() / 2 + frame8.image.GetHeight() / 2 + 48);
}

Plymouth.SetDisplayMessageFunction(message_callback);

prompt_sprite = Sprite();
bullet_sprite = Sprite();

fun password_callback(prompt, bullets) {
    if (prompt == "") prompt = "Unlock disk";
    prompt_image = Image.Text(prompt, 0.95, 0.93, 0.89, 1);
    prompt_sprite.SetImage(prompt_image);
    prompt_sprite.SetX(Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
    prompt_sprite.SetY(Window.GetHeight() * 0.72);
    bullet_image = Image.Text(bullets, 0.78, 0.65, 0.42, 1);
    bullet_sprite.SetImage(bullet_image);
    bullet_sprite.SetX(Window.GetWidth() / 2 - bullet_image.GetWidth() / 2);
    bullet_sprite.SetY(Window.GetHeight() * 0.72 + 32);
}

Plymouth.SetDisplayPasswordFunction(password_callback);
