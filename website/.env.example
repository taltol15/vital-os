# Public. Safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://bylwldjextoxqqjakxnb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BJsDXuSXkBKu_WbBZ9NXZw_j32RsrNs
NEXT_PUBLIC_SITE_URL=https://vital-os.org

# Secret. Server only. Never commit a real value. Never prefix with NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API → the secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Secret. PKCS#8 PEM for an ed25519 key. Newlines may be written as \n.
# Generate on a trusted machine and keep the private key out of git:
#   openssl genpkey -algorithm ED25519 -out market.pem
# The matching raw public key (standard base64, 32 bytes) has to replace
# marketplace/keys/catalog.pub before an ISO will trust this catalog.
VITAL_CATALOG_SIGNING_KEY=

# Secret. HMAC key for rate-limit buckets. Any long random string.
# Buckets store the hash, not the address. Rotating this starts a fresh window.
VITAL_RATE_LIMIT_SALT=

# Optional. Days that still count as a live machine. Default 14, matching PRIVACY.md.
# VITAL_LIVE_DAYS=14

# Local screenshots only. Ignored whenever VERCEL is set. Never set this in production.
# VITAL_PREVIEW=1
