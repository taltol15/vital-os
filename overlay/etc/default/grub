GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Vital OS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_THEME="/usr/share/grub/themes/vital/theme.txt"
# os-prober walks the live CD during grub-mkconfig and can fail the install.
GRUB_DISABLE_OS_PROBER=true
GRUB_TERMINAL_OUTPUT="gfxterm"
